+static void on_dmap_uint32(void *ctx, const char *code, const char *name, uint32_t value) {
+	raopsr_metadata_t *metadata = (raopsr_metadata_t *) ctx;
+
+	(void) name;
+	if (!strcasecmp(code, "astm") || !strcasecmp(code, "cast")) {
+		metadata->duration_ms = value;
+		metadata->duration_valid = true;
+	}
+	if (!strcasecmp(code, "cant")) {
+		metadata->elapsed_ms = value;
+		metadata->elapsed_valid = true;
+	}
